<?xml version = "1.0" encoding = "UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ZapretUI_Mobile.Resources.Styles.Colors">

    <!-- PC-matching palette -->
    <Color x:Key="Background">#090C11</Color>
    <Color x:Key="Surface">#11161F</Color>
    <Color x:Key="CardBackground">#141B25</Color>
    <Color x:Key="CardBorder">#1E293B</Color>

    <Color x:Key="Primary">#60A5FA</Color>
    <Color x:Key="PrimaryDark">#3B82F6</Color>
    <Color x:Key="PrimaryLight">#93C5FD</Color>
    <Color x:Key="Secondary">#1E293B</Color>

    <Color x:Key="Success">#34D399</Color>
    <Color x:Key="Danger">#E2566A</Color>
    <Color x:Key="Warning">#F5A623</Color>

    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#8888AA</Color>
    <Color x:Key="TextMuted">#555566</Color>

    <Color x:Key="OnPrimary">#090C11</Color>
    <Color x:Key="OnBackground">#FFFFFF</Color>
    <Color x:Key="OnSurface">#FFFFFF</Color>

    <Color x:Key="LogForeground">#00FF88</Color>
    <Color x:Key="LogBackground">#0D1117</Color>
</ResourceDictionary>
