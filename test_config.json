{
  "log": { "loglevel": "warning" },
  "dns": { "servers": ["1.1.1.1", "8.8.8.8"] },
  "inbounds": [
    {
      "port": 10808,
      "protocol": "socks",
      "settings": { "udp": true },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls"],
        "routeOnly": true
      },
      "tag": "socks-in"
    },
    {
      "port": 10809,
      "protocol": "http",
      "tag": "http-in"
    }
  ],
  "outbounds": [
    {
      "protocol": "vless",
      "settings": {
        "vnext": [{
          "address": "31.76.14.166",
          "port": 9443,
          "users": [{
            "id": "test-uuid",
            "encryption": "none"
          }]
        }]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality"
        ,"realitySettings": {
          "serverName": "www.google.com",
          "fingerprint": "chrome",
          "publicKey": "test-pbk",
          "shortId": "test-sid"
        }
      },
      "tag": "proxy"
    },
    { "protocol": "freedom", "tag": "direct" }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [{
      "type": "field",
      "outboundTag": "direct",
      "ip": ["geoip:private"]
    }]
  }
}

